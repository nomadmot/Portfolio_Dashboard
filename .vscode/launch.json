{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Pytest",
            "type": "debugpy",
            "console": "integratedTerminal",
            "request": "launch",
            "cwd": "${workspaceFolder}/src",
            "module": "pytest",
            "args": [ "${file}" ]
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
        },
        {
            "name": "Python:Streamlit",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}/src",
            "module": "streamlit",
            "envFile": "${workspaceFolder}/.env",
            "args": [
                "run",
                "app.py",
                "--server.port",
                "2000"
            ]
        }
    ]
}